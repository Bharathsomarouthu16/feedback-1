# Copy to .env for local dev. On Vercel, set these in Project Settings -> Environment Variables.

# --- Required ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/loop?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string

# --- Admin account (created on first connect if missing) ---
ADMIN_EMAIL=admin@loop.com
ADMIN_PASSWORD=change-me-now

# --- Optional ---
JWT_EXPIRES_IN=1h
PORT=4000
SEED_DEMO_DATA=true          # insert the 8 sample feedback items into an empty DB

# --- Optional third-party API: Resend email alerts for ratings <= 2 stars ---
RESEND_API_KEY=
NOTIFY_TO=you@example.com    # comma-separated for several recipients
NOTIFY_FROM=Loop <onboarding@resend.dev>
